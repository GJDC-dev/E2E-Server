# Instellingen van de GJDC E2E-Server op deze node.
# Staat normaal in /etc/gjdc-e2e-server/agent.env. Na een wijziging:
#   sudo systemctl restart gjdc-e2e-server

# Adres van het dashboard (verplicht, https).
DASHBOARD_URL=https://testing.gjdc.nl

# Naam en labels bij het aanmelden. Daarna pas je ze aan in het dashboard.
NODE_NAME=
NODE_LABELS=

# Hoeveel runs deze node tegelijk mag doen. Op een mini-pc meestal 1:
# Playwright draait zelf al meerdere tests parallel (workers).
MAX_JOBS=1

# Cache van testpakketten en geïnstalleerde node_modules, in MB.
# Bij een volle cache ruimt de node het langst niet gebruikte op.
CACHE_MAX_MB=4096

# Hoeveel afgeronde runmappen blijven staan om na te kijken.
KEEP_RUNS=3

# Waar alles staat (cache, runs, aanmelding).
DATA_DIR=/var/lib/gjdc-e2e-server

# Browsers van Playwright. Standaard: DATA_DIR/browsers.
#PLAYWRIGHT_BROWSERS_PATH=

# Een andere npm-registry, bijvoorbeeld een lokale cache.
#NPM_REGISTRY=

# Hoeveel seconden een lopende run mag afmaken als de dienst stopt, voordat
# hij wordt afgebroken en terug in de wachtrij gaat.
SHUTDOWN_GRACE=20

# Maximale tijd voor npm install en het installeren van browsers (seconden).
INSTALL_TIMEOUT=900

# info, debug, warn of error
LOG_LEVEL=info
